generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Admin User (Username + Hashed Password)
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String   @default("Administrator")
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 2. Global Site Settings (Singleton row: id = "default")
model SiteSettings {
  id                    String   @id @default("default")
  schoolName            String   @default("Kids Berry Kindergarten School")
  shortName             String   @default("Kids Berry")
  schoolType            String   @default("Montessori Implemented Pre-school + Daycare")
  tagline               String
  subTagline            String   @db.Text
  logoUrl               String   @default("/images/kids-berry-logo.jpg")
  establishedYear       String   @default("2020")

  // Location
  street                String   @default("Pichara, Biratnagar-11")
  ward                  String   @default("Biratnagar-11, Pichara")
  city                  String   @default("Biratnagar")
  province              String   @default("Koshi Province")
  country               String   @default("Nepal")
  fullAddress           String   @default("Pichara, Biratnagar-11, Nepal")
  landmark              String

  // Contact
  primaryPhone          String
  secondaryPhone        String
  whatsappNumber        String
  whatsappDisplay       String
  email                 String
  admissionsEmail       String

  // Timings & Key Business Flags
  openDays              String   @default("Sunday – Friday")
  regularClassTime      String   @default("9:00 AM – 3:00 PM")
  afterClassCareTime    String   @default("3:00 PM – 5:00 PM")
  daycareTime           String   @default("9:00 AM – 5:00 PM")
  closedOn              String   @default("Saturday & Public Holidays")
  daycareAvailable      Boolean  @default(true)
  foodProvided          Boolean  @default(true)
  cctvMonitoring        Boolean  @default(true)
  montessoriImplemented Boolean  @default(true)

  // Social & Maps
  facebookUrl           String
  facebookHandle        String
  instagramUrl          String
  instagramHandle       String
  googleMapsEmbedUrl    String   @db.Text
  googleMapsLinkUrl     String   @db.Text
  heroStats             Json

  updatedAt             DateTime @updatedAt
}

// 3. PageSection (Flexible CMS blocks for Home, About, Programs, Admissions, etc.)
model PageSection {
  id          String   @id @default(cuid())
  page        String
  sectionKey  String   @unique
  category    String
  badge       String?
  title       String
  subtitle    String?
  description String   @db.Text
  imageUrl    String?
  imageAlt    String?
  iconName    String   @default("sparkles")
  accent      String   @default("magenta")
  metadata    Json?
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([page, category, published])
}

// 4. Program (Care Tracks: Regular/Daycare/After-Class Care + Academic Age Groups)
model Program {
  id               String   @id @default(cuid())
  slug             String   @unique
  programType      String   @default("ACADEMIC")
  badge            String?
  title            String
  subtitle         String
  ageGroup         String
  ageEligibility   String?
  timing           String
  duration         String?
  classSize        String?
  ratio            String?
  shortDescription String   @db.Text
  fullDescription  String   @db.Text
  highlights       Json
  curriculumAreas  Json
  iconName         String   @default("blocks")
  accent           String   @default("magenta")
  imageUrl         String
  imageAlt         String
  sortOrder        Int      @default(0)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([programType, published])
}

// 5. Facility
model Facility {
  id          String   @id @default(cuid())
  badge       String
  title       String
  subtitle    String
  description String   @db.Text
  highlights  Json
  iconName    String   @default("shield")
  accent      String   @default("magenta")
  imageUrl    String
  imageAlt    String
  showOnHome  Boolean  @default(true)
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
}

// 6. GalleryImage
model GalleryImage {
  id            String   @id @default(cuid())
  title         String
  category      String
  categoryLabel String
  description   String   @db.Text
  imageUrl      String
  dateLabel     String   @default("Campus Life")
  aspect        String   @default("square")
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category, published])
}

// 7. Testimonial
model Testimonial {
  id         String   @id @default(cuid())
  parentName String
  relation   String
  childName  String
  program    String
  quote      String   @db.Text
  rating     Int      @default(5)
  location   String   @default("Biratnagar")
  accent     String   @default("magenta")
  sortOrder  Int      @default(0)
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
}

// 8. TeamMember
model TeamMember {
  id            String   @id @default(cuid())
  name          String
  role          String
  qualification String
  experience    String
  bio           String   @db.Text
  quote         String   @db.Text
  imageUrl      String
  accent        String   @default("magenta")
  sortOrder     Int      @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published])
}

// 9. FoodMenu (Weekly Food Menu – Sunday to Friday)
model FoodMenu {
  id               String   @id @default(cuid())
  day              String
  morningSnack     String
  hotLunch         String
  afternoonBooster String
  accent           String   @default("magenta")
  sortOrder        Int      @default(0)
  published        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([published])
}

// 10. ContactInquiry (Public Contact & Admission Tour Requests)
model ContactInquiry {
  id            String   @id @default(cuid())
  parentName    String
  phone         String
  email         String?
  childName     String?
  childAge      String?
  program       String?
  preferredCare String?
  preferredDate String?
  message       String?  @db.Text
  status        String   @default("NEW")
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 11. PopupNotification (CMS-driven website announcements / admission popups)
model PopupNotification {
  id        String   @id @default(cuid())
  badge     String?
  title     String
  message   String   @db.Text
  imageUrl  String?
  imageAlt  String?
  ctaLabel  String?
  ctaHref   String?
  accent    String   @default("magenta")
  sortOrder Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, sortOrder])
}

// 12. Notice (CMS-driven Notices, Exam Details, Offers, Events & Holidays with PDF/Image media)
model Notice {
  id              String   @id @default(cuid())
  title           String
  category        String   @default("notice") // "notice" | "exam" | "offer" | "event" | "holiday"
  summary         String
  content         String   @db.Text
  noticeDate      String   @default("")
  attachmentUrl   String?
  attachmentType  String?  // "image" | "pdf" | "file"
  attachmentName  String?
  accent          String   @default("magenta")
  highlightOnHome Boolean  @default(false)
  sortOrder       Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, highlightOnHome, sortOrder])
  @@index([category, published])
}
